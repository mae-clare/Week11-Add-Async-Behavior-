
abstract class PaintTool {
  String name;

  PaintTool(this.name);

  void applyPaint();
}

mixin Cleanable {
  bool isClean = true;

  void cleanTool() {
    isClean = true;
    print("$runtimeType has been cleaned.");
  }

  void makeDirty() {
    isClean = false;
  }
}

abstract class Paintbrush extends PaintTool with Cleanable {
  String color;
  double size;

  Paintbrush(String name, this.color, this.size) : super(name);

  void displayInfo() {
    print("Tool: $name");
    print("Color: $color");
    print("Size: $size");
    print("Clean: $isClean");
  }

  // Week 11: Asynchronous method that returns a Future.
  Future<String> savePainting() async {
    print("Saving painting made with $name...");

    // Simulate an operation that takes 2 seconds.
    await Future.delayed(const Duration(seconds: 2));

    return "Painting made with $color paint using $name was saved successfully.";
  }
}

class FlatPaintbrush extends Paintbrush {
  FlatPaintbrush(String color, double size)
      : super("Flat Paintbrush", color, size);

  @override
  void applyPaint() {
    makeDirty();
    print("$name spreads $color paint over a wide surface.");
  }
}

class RoundPaintbrush extends Paintbrush {
  RoundPaintbrush(String color, double size)
      : super("Round Paintbrush", color, size);

  @override
  void applyPaint() {
    makeDirty();
    print("$name creates detailed lines using $color paint.");
  }
}

class PaintPalette with Cleanable {
  String paletteName;

  PaintPalette(this.paletteName);

  void displayPalette() {
    print("Palette: $paletteName");
  }
}

Future<void> main() async {
  print("===== WEEK 11: ASYNCHRONOUS OOP =====\n");

  Paintbrush flatBrush = FlatPaintbrush("Blue", 2.5);
  Paintbrush roundBrush = RoundPaintbrush("Red", 1.0);

  print("--- Paintbrush Information ---");
  flatBrush.displayInfo();
  flatBrush.applyPaint();

  print("\n--- Async/Await Demonstration ---");

  print("1. Starting the save operation...");

  Future<String> saveFuture = flatBrush.savePainting();

  print("2. The program can continue while the save is in progress.");

  String result = await saveFuture;

  print("3. Result: $result");

  print("\n--- Other OOP Features ---");
  roundBrush.displayInfo();
  roundBrush.applyPaint();

  PaintPalette palette = PaintPalette("My Art Palette");
  palette.displayPalette();
  palette.cleanTool();

  print("\n===== PROGRAM FINISHED =====");
}
